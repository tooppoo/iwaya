# Usage errors are rendered by clap and exit with the provisional usage
# category 2 (src/main.rs module comment); nothing is executed. The one
# exception is a bare `iwaya`, which behaves exactly like `iwaya --help`.

case "reports its version" {
  $ iwaya --version
  assert {
    exit 0
    stdout contains "iwaya"
    stderr empty
  }
}

case "prints help without a subcommand, same as help option" {
  $ iwaya --help
  let help_output <- stdout
  $ iwaya
  assert {
    exit 0
    stdout text_equals &help_output
    stderr empty
  }
}

case "rejects an exec invocation without a context" {
  $ iwaya exec cmd
  assert {
    exit 2
    stderr contains "the following required arguments were not provided"
    stderr contains "--context <CONTEXT>"
    stdout empty
  }
}

case "rejects an unknown option" {
  $ iwaya exec --context c -v cmd
  assert {
    exit 2
    stderr contains "unexpected argument '-v' found"
    stdout empty
  }
}

case "rejects target-command arguments outside the separator" {
  $ iwaya exec --context c cmd extra
  assert {
    exit 2
    stderr contains "unexpected argument 'extra' found"
    stdout empty
  }
}
