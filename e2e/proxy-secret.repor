# A 'proxy-secret' policy executes through the supervisor: iwaya resolves the
# raw value, starts the proxy sidecar, and runs the target with only the
# phantom credential and the loopback proxy URL
# (docs/design/configuration.md, "Proxy-Backed Secret Delivery"). A fake
# runtime and a fake 'bws' CLI keep the cases hermetic; the fake runtime
# reuses a pre-existing proxy image ('image inspect' succeeds), answers the
# sidecar 'run' with a readiness line, and dumps its argv and environment on
# 'exec' so the assertions can observe exactly what the target would see.

before_each {
  write <"config.kdl"> ```
    iwaya version=1 {
      providers {
        bws "b" {
          project "p"
          access-token { exec "echo" "fake-access-token" }
        }
      }
      contexts {
        docker "ctx" {
          runtime "fake-docker"
          user "u"
          workdir "/w"
          container-name "target-container"
        }
      }
      policies {
        command "proxied" {
          proxy-secret "TOKEN" {
            provider "b"
            secret-name "TOKEN"
            upstream "https://api.example"
            base-url-env "TOKEN_BASE_URL"
            inject-header "x-api-key" "{}"
          }
        }
      }
    }
    ```
  write <"bws"> ```
    #!/bin/sh
    case "$1 $2" in
      "project list") echo '[{"id":"pid1","name":"p"}]' ;;
      "secret list")  echo '[{"key":"TOKEN","value":"raw-secret-value"}]' ;;
      *) exit 1 ;;
    esac
    ```
  write <"fake-docker"> ```
    #!/bin/sh
    printf '%s\n' "$*" >> calls.log
    case "$1" in
      image) exit 0 ;;
      run)   read line
             printf '%s\n' "$line" > sidecar-received
             echo '{"port":45678}' ;;
      rm)    exit 0 ;;
      exec)  echo "$@"
             echo "TOKEN=$TOKEN"
             echo "TOKEN_BASE_URL=$TOKEN_BASE_URL"
             exit "${FAKE_EXEC_EXIT:-0}" ;;
    esac
    ```
}

case "runs the target with the phantom and the proxy URL, never the raw value" {
  $ chmod +x fake-docker bws
  $ PATH="$PWD:$PATH" IWAYA_CONFIG=config.kdl iwaya exec --context ctx proxied
  assert {
    exit 0
    stdout contains "exec --interactive --tty --env TOKEN --env TOKEN_BASE_URL --user u --workdir /w target-container proxied"
    stdout contains "TOKEN=iwaya-phantom-"
    stdout contains "TOKEN_BASE_URL=http://127.0.0.1:45678"
    not {
      stdout contains "raw-secret-value"
    }
  }
}

case "delivers the raw value only through the sidecar stdin" {
  $ chmod +x fake-docker bws
  $ PATH="$PWD:$PATH" IWAYA_CONFIG=config.kdl iwaya exec --context ctx proxied
  assert {
    file <"sidecar-received"> contains "raw-secret-value"
    file <"sidecar-received"> contains "iwaya-phantom-"
    not {
      file <"calls.log"> contains "raw-secret-value"
    }
  }
}

case "starts the sidecar in the target network namespace and removes it afterwards" {
  $ chmod +x fake-docker bws
  $ PATH="$PWD:$PATH" IWAYA_CONFIG=config.kdl iwaya exec --context ctx proxied
  assert {
    file <"calls.log"> contains "run --rm --interactive --network container:target-container --name iwaya-proxy-"
    file <"calls.log"> contains "rm --force iwaya-proxy-"
  }
}

case "propagates the supervised target exit status" {
  $ chmod +x fake-docker bws
  $ PATH="$PWD:$PATH" IWAYA_CONFIG=config.kdl FAKE_EXEC_EXIT=7 iwaya exec --context ctx proxied
  assert {
    exit 7
  }
}
