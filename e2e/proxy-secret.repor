# A policy declaring 'proxy-secret' is accepted by configuration validation
# but rejected at execution until the proxy execution path exists
# (docs/design/configuration.md, "Proxy-Backed Secret Delivery"). The guard
# fires before secret resolution, so no provider is contacted.

before_each {
  write <"config.kdl"> ```
    iwaya version=1 {
      providers {
        bws "b" {
          project "p"
          access-token { exec "false" }
        }
      }
      contexts {
        docker "ctx" {
          user "u"
          workdir "/w"
          container-name "target-container"
        }
      }
      policies {
        command "proxied" {
          proxy-secret "TOKEN" {
            provider "b"
            secret-name "TOKEN"
            upstream "https://api.example"
            base-url-env "TOKEN_BASE_URL"
            inject-header "x-api-key" "{}"
          }
        }
      }
    }
    ```
}

case "rejects execution of a proxy-secret policy before resolution" {
  $ IWAYA_CONFIG=config.kdl iwaya exec --context ctx proxied
  assert {
    exit 3
    stderr contains "iwaya: error: command 'proxied' declares 'proxy-secret'"
    stderr contains "nothing was executed"
    stdout empty
  }
}
